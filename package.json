{
	"name": "spz-ky",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"predev": "node scripts/check-node.cjs",
		"dev": "vite dev",
		"prebuild": "node scripts/check-node.cjs",
		"build": "vite build",
		"prepreview": "node scripts/check-node.cjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "node scripts/check-node.cjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"pretest": "node scripts/check-node.cjs",
		"test": "vitest run",
		"presmoke": "node scripts/check-node.cjs",
		"smoke": "vite build && node scripts/smoke.mjs",
		"icons": "pwa-assets-generator"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^22.20.5",
		"@vite-pwa/assets-generator": "^2.0.0",
		"@vite-pwa/sveltekit": "^2.0.1",
		"fake-indexeddb": "^6.2.8",
		"magicast": "^0.5.5",
		"puppeteer-core": "^24.43.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vite-plugin-pwa": "^2.0.0",
		"vitest": "^5.1.0",
		"workbox-window": "^7.4.1"
	},
	"dependencies": {
		"dexie": "^4.4.7"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
